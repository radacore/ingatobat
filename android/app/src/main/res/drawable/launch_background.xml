<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash: gradien biru brand + logo jam alarm di tengah.
     Di Android 12+ digantikan system splash (lihat values-v31/styles.xml). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/launch_blue"
                android:endColor="@color/launch_blue_dark"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/launch_mark"
        android:gravity="center"
        android:width="144dp"
        android:height="144dp" />
</layer-list>
