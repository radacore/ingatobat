<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: system splash biru brand + ikon animasi (±1 detik),
         lalu disambung ke splash screen Flutter yang animasi penuh. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_mark_avd</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_blue</item>
        <item name="android:splashScreenTheme">@style/NormalTheme</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
